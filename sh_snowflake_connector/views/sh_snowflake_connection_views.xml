<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_snowflake_connection_tree" model="ir.ui.view">
        <field name="name">snowflake.connection.tree</field>
        <field name="model">snowflake.connection</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="auth_type"/>
                <field name="warehouse"/>
                <field name="state" widget="badge" decoration-success="state == 'tested'" decoration-danger="state == 'failed'" decoration-muted="state == 'draft'"/>
                <field name="last_test_date" optional="hide"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_snowflake_connection_search" model="ir.ui.view">
        <field name="name">snowflake.connection.search</field>
        <field name="model">snowflake.connection</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="account_identifier"/>
                <field name="warehouse"/>
                <filter string="Draft" name="connected" domain="[('state', '=', 'draft')]"/>
                <filter string="Connected" name="connected" domain="[('state', '=', 'tested')]"/>
                <filter string="Failed" name="failed" domain="[('state', '=', 'failed')]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>

                <group name="group_by">
                    <filter string="Auth Type" name="group_auth_type" context="{'group_by': 'auth_type'}"/>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_snowflake_connection_form" model="ir.ui.view">
        <field name="name">snowflake.connection.form</field>
        <field name="model">snowflake.connection</field>
        <field name="arch" type="xml">
            <form string="Snowflake Connection">
                <header>
                    <button name="action_test_connection" type="object" string="Test Connection" class="btn-primary" invisible="state == 'tested'"/>
                    <button name="action_reset_configuration" type="object" string="Reset Configuration" class="btn-secondary" invisible="state != 'tested'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,tested,failed"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Connected" bg_color="text-bg-success" invisible="state != 'tested'"/>
                    <widget name="web_ribbon" title="Failed" bg_color="text-bg-danger" invisible="state != 'failed'"/>
                    <div class="alert alert-success mb-3" role="alert" invisible="state != 'tested'">
                        <i class="fa fa-check-circle me-1"/>
                        <field name="last_test_message" readonly="1" nolabel="1" class="d-inline"/>
                    </div>
                    <div class="alert alert-danger mb-3" role="alert" invisible="state != 'failed'">
                        <i class="fa fa-exclamation-triangle me-1"/>
                        <field name="last_test_message" readonly="1" nolabel="1" class="d-inline"/>
                    </div>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="button" aria-label="Active">
                            <div class="o_field_widget o_stat_info">
                                <div class="d-flex align-items-center justify-content-center gap-2">
                                    <field name="active" widget="boolean_toggle" nolabel="1"/>
                                    <span class="o_stat_text">Active</span>
                                </div>
                            </div>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name" readonly="state == 'tested'"/>
                            <field name="account_identifier" readonly="state == 'tested'"/>
                            <field name="auth_type" readonly="state == 'tested'"/>
                            <field name="warehouse" readonly="state == 'tested'"/>
                            <field name="login" readonly="state == 'tested'"/>
                            <field name="password" password="True" invisible="auth_type != 'password'" readonly="state == 'tested'" groups="sh_snowflake_connector.group_snowflake_manager"/>
                            <field name="pat_token" password="True" invisible="auth_type != 'pat'" readonly="state == 'tested'" groups="sh_snowflake_connector.group_snowflake_manager"/>
                            <field name="company_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Connection Info">
                            <group>
                                <field name="last_test_date" readonly="1"/>
                                <field name="last_test_message" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_snowflake_connection" model="ir.actions.act_window">
        <field name="name">Connections</field>
        <field name="res_model">snowflake.connection</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_snowflake_connection_search"/>
    </record>
</odoo>
