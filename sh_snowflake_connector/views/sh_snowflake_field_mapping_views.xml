<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_snowflake_field_mapping_tree" model="ir.ui.view">
        <field name="name">snowflake.field.mapping.tree</field>
        <field name="model">snowflake.field.mapping</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence"/>
                <field name="field_label"/>
                <field name="field_name" readonly="1"/>
                <field name="odoo_field_type" readonly="1"/>
                <field name="column_name"/>
                <field name="column_type"/>
                <field name="column_length"/>
                <field name="is_primary_key"/>
                <field name="is_included"/>
            </list>
        </field>
    </record>

    <record id="view_snowflake_field_mapping_form" model="ir.ui.view">
        <field name="name">snowflake.field.mapping.form</field>
        <field name="model">snowflake.field.mapping</field>
        <field name="arch" type="xml">
            <form string="Snowflake Field Mapping">
                <sheet>
                    <group>
                        <group>
                            <field name="table_config_id"/>
                            <field name="odoo_field_id"/>
                            <field name="field_label" readonly="1"/>
                            <field name="field_name" readonly="1"/>
                            <field name="odoo_field_type" readonly="1"/>
                        </group>
                        <group>
                            <field name="column_name"/>
                            <field name="column_type"/>
                            <field name="column_length"/>
                            <field name="sequence"/>
                            <field name="is_primary_key"/>
                            <field name="is_included"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_snowflake_field_mapping_search" model="ir.ui.view">
        <field name="name">snowflake.field.mapping.search</field>
        <field name="model">snowflake.field.mapping</field>
        <field name="arch" type="xml">
            <search>
                <field name="table_config_id"/>
                <field name="field_name"/>
                <field name="column_name"/>
                <filter string="Included" name="included" domain="[('is_included', '=', True)]"/>
                <group name="group_by">
                    <filter string="Table Config" name="group_table" context="{'group_by': 'table_config_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_snowflake_field_mapping" model="ir.actions.act_window">
        <field name="name">Field Mappings</field>
        <field name="res_model">snowflake.field.mapping</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_snowflake_field_mapping_search"/>
    </record>
</odoo>
