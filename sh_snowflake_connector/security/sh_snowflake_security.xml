<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_snowflake_connector" model="ir.module.category">
        <field name="name">Snowflake Connector</field>
        <field name="sequence">35</field>
    </record>

    <record id="res_groups_privilege_snowflake" model="res.groups.privilege">
        <field name="name">Snowflake</field>
        <field name="sequence">1</field>
        <field name="category_id" ref="sh_snowflake_connector.module_category_snowflake_connector"/>
    </record>

    <record id="group_snowflake_user" model="res.groups">
        <field name="sequence">10</field>
        <field name="name">Snowflake / User</field>
        <field name="privilege_id" ref="sh_snowflake_connector.res_groups_privilege_snowflake"/>
    </record>

    <record id="group_snowflake_manager" model="res.groups">
        <field name="sequence">20</field>
        <field name="name">Snowflake / Manager</field>
        <field name="privilege_id" ref="sh_snowflake_connector.res_groups_privilege_snowflake"/>
        <field name="implied_ids" eval="[(4, ref('sh_snowflake_connector.group_snowflake_user'))]"/>
    </record>

    <record id="rule_snowflake_connection_company" model="ir.rule">
        <field name="name">Snowflake Connection Company Rule</field>
        <field name="model_id" ref="model_snowflake_connection"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_snowflake_database_company" model="ir.rule">
        <field name="name">Snowflake Database Company Rule</field>
        <field name="model_id" ref="model_snowflake_database"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_snowflake_table_config_company" model="ir.rule">
        <field name="name">Snowflake Table Company Rule</field>
        <field name="model_id" ref="model_snowflake_table_config"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
