<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sh_calendly_sync_queue_list" model="ir.ui.view">
        <field name="name">sh.calendly.sync.queue.list</field>
        <field name="model">sh.calendly.sync.queue</field>
        <field name="arch" type="xml">
            <list string="Queue Logs" create="0" edit="0" delete="0">
                <header>
                    <button name="action_retry" string="Retry Sync" type="object" class="btn-primary" groups="base.group_system"/>
                </header>
                <field name="create_date" column_invisible="1"/>
                <field name="sync_log_id" column_invisible="1"/>
                <field name="event_type" column_invisible="1"/>
                <field name="last_attempt_date"/>
                <field name="sync_model"/>
                <field name="operation" widget="badge"
                       decoration-info="operation == 'create'"
                       decoration-warning="operation == 'update'"
                       decoration-danger="operation == 'delete'"/>
                <field name="direction"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'failed'"/>
            </list>
        </field>
    </record>

    <record id="view_sh_calendly_sync_queue_form" model="ir.ui.view">
        <field name="name">sh.calendly.sync.queue.form</field>
        <field name="model">sh.calendly.sync.queue</field>
        <field name="arch" type="xml">
            <form string="Calendly Queue Log" create="0" edit="0" delete="0">
                <header>
                    <button name="action_retry" string="Retry Sync" type="object" class="oe_highlight"
                            invisible="state != 'failed'" groups="base.group_system"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done,failed" readonly="1"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="last_attempt_date"/>
                            <field name="operation" widget="badge"/>
                            <field name="sync_log_id" invisible="1"/>
                            <field name="event_type" invisible="1"/>
                        </group>
                        <group>
                            <field name="sync_model"/>
                            <field name="direction"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Response" invisible="not payload">
                            <field name="payload_display" readonly="1" nolabel="1"/>
                        </page>
                        <page string="Error" invisible="not error_message">
                            <field name="error_message" readonly="1" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sh_calendly_sync_queue_search" model="ir.ui.view">
        <field name="name">sh.calendly.sync.queue.search</field>
        <field name="model">sh.calendly.sync.queue</field>
        <field name="arch" type="xml">
            <search>
                <field name="state"/>
                <group>
                    <filter string="Type" name="group_by_type" context="{'group_by': 'sync_model'}"/>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Operation" name="group_by_operation" context="{'group_by': 'operation'}"/>
                    <filter string="Direction" name="group_by_direction" context="{'group_by': 'direction'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sh_calendly_sync_queue" model="ir.actions.act_window">
        <field name="name">Queue Logs</field>
        <field name="res_model">sh.calendly.sync.queue</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sh_calendly_sync_queue_search"/>
        <field name="context">{'search_default_pending': 1, 'search_default_failed': 1}</field>
    </record>
</odoo>
