<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sh_calendly_event_type_list" model="ir.ui.view">
        <field name="name">sh.calendly.event.type.list</field>
        <field name="model">sh.calendly.event.type</field>
        <field name="arch" type="xml">
            <list string="Calendly Event Types" create="0" edit="0" delete="0">
                <field name="name"/>
                <field name="duration"/>
            </list>
        </field>
    </record>
    <record id="view_sh_calendly_event_type_form" model="ir.ui.view">
        <field name="name">sh.calendly.event.type.form</field>
        <field name="model">sh.calendly.event.type</field>
        <field name="arch" type="xml">
            <form string="Calendly Event Type" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <field name="name" readonly="True"/>
                        <field name="duration" readonly="True"/>
                        <field name="sh_calendly_event_type_uri_id" readonly="True"/>
                        <field name="scheduling_url" invisible="True"/>
                        <field name="locations" invisible="True"/>
                        <field name="pooling_type" invisible="True"/>
                        <field name="calendly_updated_at" invisible="True"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_sh_calendly_event_type" model="ir.actions.act_window">
        <field name="name">Event Types</field>
        <field name="res_model">sh.calendly.event.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
