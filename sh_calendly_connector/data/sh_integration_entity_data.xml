<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="sh_calendly_entity_calendar_event" model="sh.integration.entity">
            <field name="connector_id" ref="sh_calendly_connector.sh_calendly_connector_connector"/>
            <field name="name">Calendar Meetings</field>
            <field name="model_id" ref="calendar.model_calendar_event"/>
