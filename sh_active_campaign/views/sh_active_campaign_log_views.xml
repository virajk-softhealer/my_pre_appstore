<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sh_ac_log_list_view" model="ir.ui.view">
        <field name="name">sh.active.campaign.log.list</field>
        <field name="model">sh.active.campaign.log</field>
        <field name="arch" type="xml">
            <list string="Sync Logs" create="false" edit="false">
                <field name="create_date" string="Sync Date"/>
                <field name="sh_entity"/>
                <field name="sh_operation"/>
                <field name="sh_records_processed"/>
                <field name="sh_records_failed"/>
                <field name="sh_message"/>
                <field name="sh_company_id" groups="base.group_multi_company" />
                <field name="sh_status" widget="badge"
                       decoration-success="sh_status == 'success'"
                       decoration-danger="sh_status == 'failed'"
                       decoration-warning="sh_status == 'partial'"/>
            </list>
        </field>
    </record>

    <record id="sh_ac_log_form_view" model="ir.ui.view">
        <field name="name">sh.active.campaign.log.form</field>
        <field name="model">sh.active.campaign.log</field>
        <field name="arch" type="xml">
            <form string="Sync Log" create="false" edit="false">
                <header>
                    <field name="sh_status" widget="statusbar" statusbar_visible="success,partial,failed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="create_date" readonly="1"/>
                            <field name="sh_entity"/>
                            <field name="sh_operation"/>
                        </group>
                        <group>
                            <field name="sh_records_processed"/>
                            <field name="sh_records_failed"/>
                        </group>
                    </group>
                    <group>
                        <field name="sh_company_id" groups="base.group_multi_company"/>
                    </group>
                    <group string="Message/Error">
                        <field name="sh_message" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sh_ac_log_search_view" model="ir.ui.view">
        <field name="name">sh.active.campaign.log.search</field>
        <field name="model">sh.active.campaign.log</field>
        <field name="arch" type="xml">
            <search string="Sync Logs">
                <field name="sh_message" string="Log Message/Error"/>
                <field name="sh_entity" string="Entity"/>
                <filter string="Import" name="import" domain="[('sh_operation', '=', 'import')]"/>
                <filter string="Export" name="export" domain="[('sh_operation', '=', 'export')]"/>
                <separator/>
                <filter string="Success" name="success" domain="[('sh_status', '=', 'success')]"/>
                <filter string="Failed" name="failed" domain="[('sh_status', '=', 'failed')]"/>
                <filter string="Partial" name="partial" domain="[('sh_status', '=', 'partial')]"/>
                <separator/>
                <filter string="Sync Date" name="filter_create_date" date="create_date"/>
                <group>
                    <filter string="Entity" name="group_by_entity" context="{'group_by': 'sh_entity'}"/>
                    <filter string="Operation" name="group_by_operation" context="{'group_by': 'sh_operation'}"/>
                    <filter string="Status" name="group_by_status" context="{'group_by': 'sh_status'}"/>
                    <filter string="Sync Date" name="group_by_date" context="{'group_by': 'create_date'}"/>
                    <filter string="Company" name="group_by_company" context="{'group_by': 'sh_company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
