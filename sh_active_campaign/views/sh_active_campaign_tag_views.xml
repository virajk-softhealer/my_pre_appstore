<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sh_ac_tag_list_view" model="ir.ui.view">
        <field name="name">sh.active.campaign.tag.list</field>
        <field name="model">sh.active.campaign.tag</field>
        <field name="arch" type="xml">
            <list string="Active Campaign Tags" create="false">
                <field name="sh_tag_name"/>
                <field name="sh_tag_type"/>
                <field name="sh_tag_id"/>
                <field name="create_date" string="Creation Date"/>
                <!-- <field name="sh_category_id"/> -->
                <field name="sh_company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="sh_ac_tag_form_view" model="ir.ui.view">
        <field name="name">sh.active.campaign.tag.form</field>
        <field name="model">sh.active.campaign.tag</field>
        <field name="arch" type="xml">
            <form string="AC Tag" create="false">
                <sheet>
                    <group>
                        <group>
                            <field name="sh_tag_name" readonly="1"/>
                            <field name="sh_tag_type" readonly="1"/>
                            <field name="sh_tag_id" readonly="1"/>
                        </group>
                        <group>
                            <!-- <field name="sh_category_id"/> -->
                            <field name="create_date" readonly="1"/>
                            <field name="sh_company_id" groups="base.group_multi_company" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
