<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sh_active_campaign_sync_queue_view_list" model="ir.ui.view">
        <field name="name">sh.active.campaign.sync.queue.view.list</field>
        <field name="model">sh.active.campaign.sync.queue</field>
        <field name="arch" type="xml">
            <list string="Sync Queue" create="false" edit="false"
                  decoration-info="sh_state == 'draft'"
                  decoration-success="sh_state == 'done'"
                  decoration-danger="sh_state == 'failed'">
                <header>
                    <button name="action_retry" string="Retry Queue"
                            type="object" class="btn-primary"
                            groups="sh_active_campaign.group_sh_active_campaign_manager"/>
                </header>
                <field name="create_date"/>
                <field name="sh_dashboard_id"/>
                <field name="sh_sync_key"/>
                <field name="sh_company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="sh_last_attempt_date"/>
                <field name="sh_state" widget="badge"
                       decoration-info="sh_state == 'draft'"
                       decoration-success="sh_state == 'done'"
                       decoration-danger="sh_state == 'failed'"/>
            </list>
        </field>
    </record>

    <record id="sh_active_campaign_sync_queue_view_form" model="ir.ui.view">
        <field name="name">sh.active.campaign.sync.queue.view.form</field>
        <field name="model">sh.active.campaign.sync.queue</field>
        <field name="arch" type="xml">
            <form string="Sync Queue Record" create="false" edit="false">
                <header>
                    <button name="action_retry" string="Retry Queue" type="object"
                            class="oe_highlight" invisible="sh_state == 'done'"
                            groups="sh_active_campaign.group_sh_active_campaign_manager"/>
                    <field name="sh_state" widget="statusbar" statusbar_visible="draft,done,failed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="sh_sync_key"/>
                            <field name="sh_dashboard_id" options="{'no_open': True, 'no_create': True}"/>
                            <field name="sh_company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="sh_last_attempt_date"/>
                            <field name="sh_state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Snapshot Payload" invisible="not sh_payload">
                            <field name="sh_payload" readonly="1" nolabel="1"/>
                        </page>
                        <page string="Last Error Message" invisible="not sh_error_message">
                            <field name="sh_error_message" readonly="1" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sh_active_campaign_sync_queue_view_search" model="ir.ui.view">
        <field name="name">sh.active.campaign.sync.queue.view.search</field>
        <field name="model">sh.active.campaign.sync.queue</field>
        <field name="arch" type="xml">
            <search>
                <field name="sh_dashboard_id"/>
                <field name="sh_sync_key"/>
                <field name="sh_state"/>
                <filter string="Pending" name="pending" domain="[('sh_state', '=', 'draft')]"/>
                <filter string="Failed" name="failed" domain="[('sh_state', '=', 'failed')]"/>
                <filter string="Done" name="done" domain="[('sh_state', '=', 'done')]"/>
                <group>
                    <filter string="Job" name="group_by_job" context="{'group_by': 'sh_sync_key'}"/>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'sh_state'}"/>
                    <filter string="Dashboard" name="group_by_dashboard" context="{'group_by': 'sh_dashboard_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="sh_active_campaign_sync_queue_action" model="ir.actions.act_window">
        <field name="name">Sync Queue</field>
        <field name="res_model">sh.active.campaign.sync.queue</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="sh_active_campaign_sync_queue_view_search"/>
        <field name="context">{'search_default_pending': 1, 'search_default_failed': 1}</field>
    </record>
</odoo>
