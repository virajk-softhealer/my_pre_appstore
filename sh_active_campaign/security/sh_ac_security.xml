<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sh_active_campaign" model="ir.module.category">
        <field name="name">Active Campaign</field>
        <field name="sequence">36</field>
    </record>

    <record id="group_sh_active_campaign_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="sh_active_campaign.module_category_sh_active_campaign"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_sh_active_campaign_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="sh_active_campaign.module_category_sh_active_campaign"/>
        <field name="implied_ids" eval="[(4, ref('sh_active_campaign.group_sh_active_campaign_user'))]"/>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('sh_active_campaign.group_sh_active_campaign_manager'))]"/>
    </record>

    <!-- Tags: company isolation -->
    <!-- <record id="sh_ac_tag_company_rule" model="ir.rule">
        <field name="name">AC Tag: Company Rule</field>
        <field name="model_id" ref="model_sh_active_campaign_tag"/>
        <field name="domain_force">['|',('sh_company_id','=',False),('sh_company_id','in',company_ids)]</field>
    </record> -->

    <!-- Campaigns: company isolation -->
    <record id="sh_ac_campaign_company_rule" model="ir.rule">
        <field name="name">AC Campaign: Company Rule</field>
        <field name="model_id" ref="model_sh_active_campaign_campaign"/>
        <field name="domain_force">['|',('sh_company_id','=',False),('sh_company_id','in',company_ids)]</field>
    </record>

    <!-- Forms: company isolation -->
    <record id="sh_ac_form_company_rule" model="ir.rule">
        <field name="name">AC Form: Company Rule</field>
        <field name="model_id" ref="model_sh_active_campaign_form"/>
        <field name="domain_force">['|',('sh_company_id','=',False),('sh_company_id','in',company_ids)]</field>
    </record>

    <!-- Dashboard: company isolation -->
    <record id="sh_ac_dashboard_company_rule" model="ir.rule">
        <field name="name">AC Dashboard: Company Rule</field>
        <field name="model_id" ref="model_sh_active_campaign_dashboard"/>
        <field name="domain_force">['|',('sh_company_id','=',False),('sh_company_id','in',company_ids)]</field>
    </record>

    <!-- Logs: company isolation -->
    <record id="sh_ac_log_company_rule" model="ir.rule">
        <field name="name">AC Log: Company Rule</field>
        <field name="model_id" ref="model_sh_active_campaign_log"/>
        <field name="domain_force">['|',('sh_company_id','=',False),('sh_company_id','in',company_ids)]</field>
    </record>

    <!-- Sync Queue: company isolation -->
    <record id="sh_ac_queue_company_rule" model="ir.rule">
        <field name="name">AC Sync Queue: Company Rule</field>
        <field name="model_id" ref="model_sh_active_campaign_sync_queue"/>
        <field name="domain_force">['|',('sh_company_id','=',False),('sh_company_id','in',company_ids)]</field>
    </record>
</odoo>
