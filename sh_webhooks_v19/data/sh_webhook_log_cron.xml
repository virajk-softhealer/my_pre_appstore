<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_webhook_log_cleanup" model="ir.cron">
            <field name="name">Webhook: Cleanup Webhook Logs</field>
            <field name="model_id" ref="model_sh_webhook_log"/>
            <field name="state">code</field>
            <field name="code">model._gc_webhook_logs()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        <record id="ir_cron_process_webhook_queue" model="ir.cron">
            <field name="name">Webhook: Process Pending Queue</field>
            <field name="model_id" ref="model_sh_webhook_action"/>
            <field name="state">code</field>
            <field name="code">model._process_webhook_queue()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>