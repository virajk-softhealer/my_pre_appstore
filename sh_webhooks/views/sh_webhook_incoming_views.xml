<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sh_webhook_incoming_view_form" model="ir.ui.view">
        <field name="name">sh.webhook.incoming.view.form</field>
        <field name="model">sh.webhook.incoming</field>
        <field name="arch" type="xml">
            <form string="Incoming Webhook Route">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Webhook Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Receive Data from External App"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="model_id" options="{'no_create': True}"/>
                            <field name="method"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="url" widget="CopyClipboardChar" readonly="0"/>
                            <field name="token" groups="base.group_no_one"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Python Code" name="code">
                            <div class="alert alert-info" role="alert">
                                <strong>Available variables:</strong><br/>
                                <code>env</code>: Odoo environment<br/>
                                <code>model</code>: Odoo model selected above<br/>
                                <code>payload</code>: The received data (Dict)<br/>
                                <code>headers</code>: HTTP headers<br/>
                                <code>result</code>: Dict to return as JSON response (e.g. <code>result['id'] = 123</code>)
                            </div>
                            <field name="code" widget="code" options="{'mode': 'python'}"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="sh_webhook_incoming_view_tree" model="ir.ui.view">
        <field name="name">sh.webhook.incoming.view.tree</field>
        <field name="model">sh.webhook.incoming</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="model_id"/>
                <field name="method"/>
                <field name="url"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="sh_webhook_incoming_view_search" model="ir.ui.view">
        <field name="name">sh.webhook.incoming.view.search</field>
        <field name="model">sh.webhook.incoming</field>
        <field name="arch" type="xml">
            <search string="Webhook Requests">
                <field name="name"/>
                <field name="model_id"/>
                <field name="url"/>
                
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                
                <group>
                    <filter string="Model" name="group_model" context="{'group_by': 'model_id'}"/>
                    <filter string="Method" name="group_method" context="{'group_by': 'method'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="sh_webhook_incoming_action" model="ir.actions.act_window">
        <field name="name">Webhook Requests</field>
        <field name="res_model">sh.webhook.incoming</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
