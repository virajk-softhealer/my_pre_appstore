<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sh_webhook_log_view_form" model="ir.ui.view">
        <field name="name">sh.webhook.log.view.form</field>
        <field name="model">sh.webhook.log</field>
        <field name="arch" type="xml">
            <form string="Webhook Log" create="false" edit="false">
                <header>
                    <button name="action_retry" string="Retry Sync" type="object"
                        invisible="state != 'error'"
                        class="oe_highlight"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="direction" widget="radio" options="{'horizontal': true}"/>
                            <field name="webhook_id" invisible="direction != 'outbound'"/>
                            <field name="incoming_webhook_id" invisible="direction != 'inbound'"/>
                        </group>
                        <group>
                            <field name="create_date" string="Date"/>
                            <field name="method"/>
                            <field name="status_code"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="res_model" invisible="1"/>
                            <field name="res_ids" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Request Header">
                            <field name="request_header" widget="code" options="{'mode': 'javascript'}"/>
                        </page>
                        <page string="Request Body">
                            <field name="request_body" widget="code" options="{'mode': 'javascript'}"/>
                        </page>
                        <page string="Response Header">
                            <field name="response_header" widget="code" options="{'mode': 'javascript'}"/>
                        </page>
                        <page string="Response Body">
                            <field name="response_body" widget="code" options="{'mode': 'javascript'}"/>
                        </page>
                        <page string="Error Message" invisible="not error_msg">
                            <field name="error_msg"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sh_webhook_log_view_tree" model="ir.ui.view">
        <field name="name">sh.webhook.log.view.tree</field>
        <field name="model">sh.webhook.log</field>
        <field name="arch" type="xml">
            <list string="Webhook Logs" create="false" edit="false">
                <field name="create_date" string="Date"/>
                <field name="direction" widget="badge" decoration-info="direction == 'outbound'" decoration-warning="direction == 'inbound'"/>
                <field name="webhook_id" optional="show"/>
                <field name="incoming_webhook_id" optional="hide"/>
                <field name="method"/>
                <field name="status_code"/>
                <field name="state" widget="badge" decoration-success="state == 'success'" decoration-danger="state == 'error'" decoration-info="state == 'pending'"/>
            </list>
        </field>
    </record>

    <record id="sh_webhook_log_view_pivot" model="ir.ui.view">
        <field name="name">sh.webhook.log.view.pivot</field>
        <field name="model">sh.webhook.log</field>
        <field name="arch" type="xml">
            <pivot string="Webhook Analytics">
                <field name="create_date" interval="day" type="row"/>
                <field name="state" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="sh_webhook_log_view_graph" model="ir.ui.view">
        <field name="name">sh.webhook.log.view.graph</field>
        <field name="model">sh.webhook.log</field>
        <field name="arch" type="xml">
            <graph string="Webhook Traffic" type="line">
                <field name="create_date" interval="day"/>
                <field name="id" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="sh_webhook_log_view_search" model="ir.ui.view">
        <field name="name">sh.webhook.log.view.search</field>
        <field name="model">sh.webhook.log</field>
        <field name="arch" type="xml">
            <search string="Webhook Logs">
                <field name="webhook_id"/>
                <field name="incoming_webhook_id"/>
                <field name="res_model"/>
                <field name="method"/>
                
                <filter string="Outbound" name="outbound" domain="[('direction', '=', 'outbound')]"/>
                <filter string="Inbound" name="inbound" domain="[('direction', '=', 'inbound')]"/>
                <separator/>
                <filter string="Success" name="success" domain="[('state', '=', 'success')]"/>
                <filter string="Error" name="error" domain="[('state', '=', 'error')]"/>
                
                <group>
                    <filter string="Direction" name="group_direction" context="{'group_by': 'direction'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'state'}"/>
                    <filter string="Method" name="group_method" context="{'group_by': 'method'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'create_date'}"/>
                    <filter string="Outgoing Webhook" name="group_webhook" context="{'group_by': 'webhook_id'}"/>
                    <filter string="Incoming Webhook" name="group_incoming" context="{'group_by': 'incoming_webhook_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="sh_webhook_log_action" model="ir.actions.act_window">
        <field name="name">Webhook Logs</field>
        <field name="res_model">sh.webhook.log</field>
        <field name="view_mode">list,form,graph,pivot</field>
    </record>
</odoo>
