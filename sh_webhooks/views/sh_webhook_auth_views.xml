<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sh_webhook_auth_view_form" model="ir.ui.view">
        <field name="name">sh.webhook.auth.view.form</field>
        <field name="model">sh.webhook.auth</field>
        <field name="arch" type="xml">
            <form string="Webhook Authentication">
                <header>
                    <button name="action_test_auth" string="Test &amp; Confirm" type="object" class="oe_highlight"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,success,failed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Profile Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. My API Auth"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="auth_type" widget="radio"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group string="Basic Authentication" invisible="auth_type != 'basic'">
                        <field name="username" required="auth_type == 'basic'"/>
                        <field name="password" password="True" required="auth_type == 'basic'"/>
                    </group>
                    <group string="Bearer Token" invisible="auth_type != 'bearer'">
                        <field name="token" required="auth_type == 'bearer'"/>
                    </group>
                    <group string="API Key" invisible="auth_type != 'apikey'">
                        <field name="api_key_name" required="auth_type == 'apikey'"/>
                        <field name="api_key_value" required="auth_type == 'apikey'"/>
                        <field name="api_key_location" widget="radio" required="auth_type == 'apikey'"/>
                    </group>
                    <group string="Verification Settings">
                        <field name="test_url" placeholder="https://api.example.com/test-auth"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sh_webhook_auth_view_tree" model="ir.ui.view">
        <field name="name">sh.webhook.auth.view.tree</field>
        <field name="model">sh.webhook.auth</field>
        <field name="arch" type="xml">
            <list string="Webhook Authentications">
                <field name="name"/>
                <field name="auth_type"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="sh_webhook_auth_action" model="ir.actions.act_window">
        <field name="name">Webhook Authentications</field>
        <field name="res_model">sh.webhook.auth</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
