<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <record id="sh_freshdesk_connector_connector" model="sh.integration.connector">
            <field name="name">Freshdesk Connector</field>
            <field name="technical_name">sh_freshdesk_connector</field>
            <field name="sequence">10</field>
            <field name="color">8</field>
            <!-- Connection status -->
            <field name="config_model">res.company</field>
            <field name="connected_field">sh_freshdesk_api_key</field>
            <!-- Log -->
            <field name="log_model">sh.freshdesk.sync.log</field>
            <field name="log_date_field">sync_date</field>
            <field name="log_state_field">status</field>
            <field name="log_error_value">error</field>
            <field name="log_message_field">message</field>
            <!-- Queue -->
            <field name="queue_model">sh.freshdesk.sync.queue</field>
            <field name="queue_state_field">state</field>
            <field name="queue_pending_value">draft</field>
            <field name="queue_done_value">done</field>
            <field name="queue_error_value">failed</field>
            <!-- Actions -->
            <field name="config_action">sh_freshdesk_connector.action_sh_freshdesk_config_settings</field>
            <!-- Menu -->
            <field name="menu_name">Freshdesk</field>
            <field name="menu_sequence">10</field>
        </record>
    </data>

    <data noupdate="0">
        <!-- Trigger dynamic menu reparenting on every module upgrade to ensure Hub consistency -->
        <function model="sh.integration.connector" name="action_sync_menus_by_module">
            <value>sh_freshdesk_connector</value>
        </function>
    </data>
</odoo>
