<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_sh_fd_sync" model="ir.ui.view">
        <field name="name">res.partner.form.sh.fd.sync</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_sync_to_freshdesk" 
                        string="Sync to Freshdesk" 
                        type="object" class="oe_highlight"
                        context="{'sh_is_sync_button': True}"
                        groups="sh_freshdesk_connector.group_freshdesk_manager"/>
                </header>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Freshdesk Details" name="freshdesk_connector" invisible="not sh_freshdesk_id">
                    <group>
                        <group>
                            <field name="sh_freshdesk_id" readonly="1"/>
                            <field name="sh_last_synced_from_fd" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_partner_tree_sh_fd_sync" model="ir.ui.view">
        <field name="name">res.partner.tree.sh.fd.sync</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='email']" position="after">
                <field name="sh_freshdesk_id" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_res_partner_filter_sh_fd" model="ir.ui.view">
        <field name="name">res.partner.select.sh.fd</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='inactive']" position="before">
                <filter string="Freshdesk Synced" name="freshdesk_synced" domain="[('sh_freshdesk_id', '!=', False)]"/>
                <filter string="Freshdesk Not Synced" name="freshdesk_not_synced" domain="[('sh_freshdesk_id', '=', False)]"/>
                <separator/>
            </xpath>
        </field>
    </record>
</odoo>
