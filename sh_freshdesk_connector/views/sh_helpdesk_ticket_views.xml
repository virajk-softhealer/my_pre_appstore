<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="helpdesk_ticket_view_form_sh_fd" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form.sh.fd</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_sync_ticket_to_freshdesk" string="Sync to Freshdesk" type="object" class="oe_highlight" context="{'sh_is_sync_button': True}"/>
                <!-- <button name="action_fetch_fd_conversations" string="Fetch FD Notes" type="object" invisible="not sh_freshdesk_id"/> -->
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Freshdesk Details" name="freshdesk_connector" invisible="not sh_freshdesk_id">
                    <group>
                        <group>
                            <field name="sh_freshdesk_id" readonly="1"/>
                            <field name="sh_last_synced_from_fd" readonly="1"/>
                        </group>
                        <group>
                            <field name="sh_freshdesk_status" readonly="1"/>
                            <field name="sh_freshdesk_priority" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="sh_freshdesk_webhook_payload" nolabel="1" widget="text" invisible="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="helpdesk_ticket_view_list_sh_fd" model="ir.ui.view">
        <field name="name">helpdesk.ticket.list.sh.fd</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_tickets_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="sh_freshdesk_id" optional="show"/>
                <field name="sh_freshdesk_status" optional="hide"/>
                <field name="sh_freshdesk_priority" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="helpdesk_ticket_view_search_sh_fd" model="ir.ui.view">
        <field name="name">helpdesk.ticket.search.sh.fd</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_tickets_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='is_open']" position="before">
                <filter string="Freshdesk Synced" name="freshdesk_synced" domain="[('sh_freshdesk_id', '!=', False)]"/>
                <filter string="Freshdesk Not Synced" name="freshdesk_not_synced" domain="[('sh_freshdesk_id', '=', False)]"/>
                <separator/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter string="Freshdesk Status" name="group_by_fd_status" context="{'group_by': 'sh_freshdesk_status'}"/>
                <filter string="Freshdesk Priority" name="group_by_fd_priority" context="{'group_by': 'sh_freshdesk_priority'}"/>
            </xpath>
        </field>
    </record>
</odoo>
