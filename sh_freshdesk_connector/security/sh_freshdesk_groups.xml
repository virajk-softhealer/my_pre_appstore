<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_freshdesk" model="res.groups.privilege">
        <field name="name">Freshdesk</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>

    <record id="group_freshdesk_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_freshdesk"/>
    </record>

    <record id="group_freshdesk_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_freshdesk"/>
        <field name="implied_ids" eval="[(4, ref('group_freshdesk_user'))]"/>
    </record>
</odoo>
